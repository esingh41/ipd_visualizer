# Python bytecode and tooling caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.ipynb_checkpoints/

# Local environments and environment variables
.env
.env.*
!.env.example
.venv/
venv/
env/
ENV/
.conda/
.python-version

# Python build/package output
build/
dist/
*.egg-info/
.eggs/

# Frontend package/build artifacts (the active app has no build step)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editors and operating-system files
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# Local logs and temporary files
*.log
*.tmp

# Research inputs and persistent application collections are local-only.
# Ignoring them prevents accidental commits; it does not make them disposable.
data/
*.pkl
*.pickle
